# Прод-переменные (их пишет deploy-workflow в ~/sportnis/.env на сервере из GitHub-секретов).
# Здесь — только для справки/локального теста прод-стека.

# Docker Hub аккаунт, откуда тянутся образы sportnis-api / sportnis-web.
DOCKERHUB_USER=your_dockerhub_login
IMAGE_TAG=latest

# Postgres.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# JWT (обязательно длинный секрет ≥32 символов).
APP_JWT_SECRET=change-me-to-a-very-long-secret-key-at-least-32-characters
APP_JWT_EXPIRATION_SECONDS=2592000

# Порт, на который контейнер web биндится на localhost; хостовый nginx проксирует сюда sportnis.ru.
WEB_PORT=8090
